import { Theme } from "theme.slint";
import {
    PlaybackState,
    TransformState,
    CropState,
    ResolutionState,
    AudioState,
    CompressState,
    QueueState,
    QueueItem,
    ToolPipelineState,
    ToolItem,
    ExportDialogState,
    ExportPhase,
    AppearanceState,
    PersistenceSettingsState,
    ToolPersistenceRow,
    ShortcutsState,
    ShortcutRow,
} from "state.slint";
import { IconButton } from "components/icon_button.slint";
import { VideoPreview } from "preview/video_preview.slint";
import { Sidebar } from "sidebar/sidebar.slint";
import { IntroSidebar } from "sidebar/intro_sidebar.slint";
import { ScrubberBar } from "timeline/scrubber_bar.slint";
import { ExportDialog } from "export/export_dialog.slint";
import { SettingsDialog } from "settings/appearance_dialog.slint";
import { QueueCarousel } from "queue/queue_carousel.slint";

// Re-exported so Rust can reach these globals via `app.global::<T>()` —
// Slint only generates Rust bindings for globals exported from the root
// file passed to `slint_build::compile`.
export {
    Theme,
    PlaybackState,
    TransformState,
    CropState,
    ResolutionState,
    AudioState,
    CompressState,
    QueueState,
    QueueItem,
    ToolPipelineState,
    ToolItem,
    ExportDialogState,
    ExportPhase,
    AppearanceState,
    PersistenceSettingsState,
    ToolPersistenceRow,
    ShortcutsState,
    ShortcutRow,
}

// Root window: branded command bar, queue, and a unified editor shell.
export component App inherits Window {
    title: "ClipForge";
    icon: @image-url("../icons/src/app-icon.svg");
    preferred-width: 1100px;
    preferred-height: 680px;
    min-width: 960px;
    min-height: 600px;
    background: Theme.bg;

    in property <bool> has-clip: false;
    in property <image> preview-frame;
    in property <string> load-error-text: "";
    in property <int> source-width: 1;
    in property <int> source-height: 1;
    in property <bool> can-undo: false;
    in property <bool> can-redo: false;
    out property <int> preview-viewport-width: Math.round(preview.width / 1px);
    out property <int> preview-viewport-height: Math.round(preview.height / 1px);

    callback open-clip-clicked;
    callback export-clicked;
    callback export-current-clicked;
    callback undo-requested;
    callback redo-requested;

    pure function mouse-button-ordinal(button: PointerEventButton) -> int {
        if (button == PointerEventButton.left) {
            0
        } else if (button == PointerEventButton.right) {
            1
        } else if (button == PointerEventButton.middle) {
            2
        } else if (button == PointerEventButton.back) {
            3
        } else if (button == PointerEventButton.forward) {
            4
        } else {
            5
        }
    }

    FocusScope {
        // Grabs focus on startup so Ctrl/Cmd+Z work without first clicking
        // into the window; individual controls (text fields, spin boxes)
        // still take focus normally when clicked.
        init => { self.focus(); }

        key-pressed(event) => {
            if (event.text == "z" && (event.modifiers.control || event.modifiers.meta)) {
                if (event.modifiers.shift) {
                    root.redo-requested();
                } else {
                    root.undo-requested();
                }
                accept
            } else if (ShortcutsState.dispatch-key(
                event.text,
                event.modifiers.control,
                event.modifiers.shift,
                event.modifiers.alt,
                event.modifiers.meta,
            )) {
                accept
            } else {
                reject
            }
        }

        // Bottom-most layer: catches clicks over otherwise-empty space (e.g.
        // the loaded video frame, which has no TouchArea of its own) for
        // mouse-button-bound shortcuts. Sitting behind every other element
        // here means buttons, drag handles, and dialogs all still claim
        // their own clicks first — this only fires when nothing else does.
        TouchArea {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    ShortcutsState.dispatch-mouse(
                        root.mouse-button-ordinal(event.button),
                        event.modifiers.control,
                        event.modifiers.shift,
                        event.modifiers.alt,
                        event.modifiers.meta,
                    );
                }
            }
        }

        VerticalLayout {
            workspace := VerticalLayout {
                padding: Theme.space-3;
                spacing: Theme.space-3;

                QueueCarousel {
                    items: QueueState.items;
                    count: QueueState.count;
                    active-index: QueueState.active-index;
                    can-previous: QueueState.can-previous;
                    can-next: QueueState.can-next;
                    add-clicked => { root.open-clip-clicked(); }
                    export-clicked => { root.export-clicked(); }
                    export-current-clicked => { root.export-current-clicked(); }
                    remove-clicked => { QueueState.remove-clicked(); }
                    select-clicked(index) => { QueueState.select-clicked(index); }
                    previous-clicked => { QueueState.previous-clicked(); }
                    next-clicked => { QueueState.next-clicked(); }
                }

                editor-shell := Rectangle {
                    vertical-stretch: 1;
                    background: Theme.surface;
                    border-radius: Theme.radius-panel;
                    border-width: 1px;
                    border-color: Theme.border-color;
                    clip: true;

                    VerticalLayout {
                        HorizontalLayout {
                            vertical-stretch: 1;

                            preview := VideoPreview {
                                horizontal-stretch: 1;
                                has-clip: root.has-clip;
                                frame: root.preview-frame;
                                error-text: root.load-error-text;
                                source-width: root.source-width;
                                source-height: root.source-height;
                                empty-clicked => { root.open-clip-clicked(); }
                            }

                            if root.has-clip: Sidebar {}
                            if !root.has-clip: IntroSidebar {}
                        }

                        if root.has-clip: ScrubberBar {}
                    }
                }
            }
        }

        undo-dock := Rectangle {
            x: parent.width - self.width - Theme.space-4;
            y: parent.height - self.height - Theme.space-4;
            width: 68px;
            height: 36px;
            background: Theme.surface;
            border-radius: Theme.radius-control;
            border-width: 1px;
            border-color: Theme.border-color;

            HorizontalLayout {
                padding: Theme.space-1;
                spacing: Theme.space-1;

                IconButton {
                    icon: @image-url("../icons/ui/undo-2.svg");
                    accessible-label: "Undo";
                    is-enabled: root.can-undo;
                    clicked => { root.undo-requested(); }
                }

                IconButton {
                    icon: @image-url("../icons/ui/redo-2.svg");
                    accessible-label: "Redo";
                    is-enabled: root.can-redo;
                    clicked => { root.redo-requested(); }
                }
            }
        }

        settings-dock := Rectangle {
            x: Theme.space-4;
            y: parent.height - self.height - Theme.space-4;
            width: 36px;
            height: 36px;
            background: Theme.surface;
            border-radius: Theme.radius-control;
            border-width: 1px;
            border-color: Theme.border-color;

            IconButton {
                icon: @image-url("../icons/ui/settings.svg");
                accessible-label: "Settings";
                clicked => { AppearanceState.open-requested(); }
            }
        }
    }

    if ExportDialogState.visible: Rectangle {
        background: #000000.with-alpha(0.4);

        // Consumes clicks so the dimmed backdrop blocks interaction with
        // everything behind the dialog instead of letting them pass through.
        TouchArea {}

        ExportDialog {
            width: 400px;
            height: 220px;
        }
    }

    if AppearanceState.visible: Rectangle {
        background: #000000.with-alpha(0.4);

        // Same click-blocking backdrop as the export dialog above.
        TouchArea {}

        SettingsDialog {
            width: 420px;
            height: 520px;
        }
    }

    // Transparent full-window capture layer for recording a new shortcut
    // binding, shown above everything (including the settings dialog) so it
    // sees the very next key press or mouse click regardless of what's
    // currently focused or hovered.
    if ShortcutsState.listening-index >= 0: Rectangle {
        capture-focus := FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    ShortcutsState.listening-cancelled();
                } else {
                    ShortcutsState.key-captured(
                        event.text,
                        event.modifiers.control,
                        event.modifiers.shift,
                        event.modifiers.alt,
                        event.modifiers.meta,
                    );
                }
                accept
            }
        }

        TouchArea {
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    ShortcutsState.mouse-captured(
                        root.mouse-button-ordinal(event.button),
                        event.modifiers.control,
                        event.modifiers.shift,
                        event.modifiers.alt,
                        event.modifiers.meta,
                    );
                }
            }
        }
    }
}
