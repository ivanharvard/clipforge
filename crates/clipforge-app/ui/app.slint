import { Theme } from "theme.slint";
import {
    PlaybackState,
    TransformState,
    CropState,
    ResolutionState,
    AudioState,
    CompressState,
    QueueState,
    QueueItem,
    ToolPipelineState,
    ToolItem,
    ExportDialogState,
    ExportPhase,
} from "state.slint";
import { TitleBar } from "components/title_bar.slint";
import { VideoPreview } from "preview/video_preview.slint";
import { Sidebar } from "sidebar/sidebar.slint";
import { IntroSidebar } from "sidebar/intro_sidebar.slint";
import { ScrubberBar } from "timeline/scrubber_bar.slint";
import { ExportDialog } from "export/export_dialog.slint";
import { QueueCarousel } from "queue/queue_carousel.slint";

// Re-exported so Rust can reach these globals via `app.global::<T>()` —
// Slint only generates Rust bindings for globals exported from the root
// file passed to `slint_build::compile`.
export {
    Theme,
    PlaybackState,
    TransformState,
    CropState,
    ResolutionState,
    AudioState,
    CompressState,
    QueueState,
    QueueItem,
    ToolPipelineState,
    ToolItem,
    ExportDialogState,
    ExportPhase,
}

// Root window: branded command bar, queue, and a unified editor shell.
export component App inherits Window {
    title: "ClipForge";
    icon: @image-url("../icons/src/app-icon.svg");
    preferred-width: 1100px;
    preferred-height: 680px;
    min-width: 960px;
    min-height: 600px;
    background: Theme.bg;

    in property <bool> has-clip: false;
    in property <image> preview-frame;
    in property <string> load-error-text: "";
    in property <int> source-width: 1;
    in property <int> source-height: 1;
    in property <bool> can-undo: false;
    in property <bool> can-redo: false;
    out property <int> preview-viewport-width: Math.round(preview.width / 1px);
    out property <int> preview-viewport-height: Math.round(preview.height / 1px);

    callback open-clip-clicked;
    callback export-clicked;
    callback undo-requested <=> title-bar.undo-clicked;
    callback redo-requested <=> title-bar.redo-clicked;

    FocusScope {
        // Grabs focus on startup so Ctrl/Cmd+Z work without first clicking
        // into the window; individual controls (text fields, spin boxes)
        // still take focus normally when clicked.
        init => { self.focus(); }

        key-pressed(event) => {
            if (event.text == "z" && (event.modifiers.control || event.modifiers.meta)) {
                if (event.modifiers.shift) {
                    root.redo-requested();
                } else {
                    root.undo-requested();
                }
                accept
            } else {
                reject
            }
        }

        VerticalLayout {
            title-bar := TitleBar {
                can-undo: root.can-undo;
                can-redo: root.can-redo;
            }

            workspace := VerticalLayout {
                padding: Theme.space-3;
                spacing: Theme.space-3;

                QueueCarousel {
                    add-clicked => { root.open-clip-clicked(); }
                    export-clicked => { root.export-clicked(); }
                }

                editor-shell := Rectangle {
                    vertical-stretch: 1;
                    background: Theme.surface;
                    border-radius: Theme.radius-panel;
                    border-width: 1px;
                    border-color: Theme.border-color;
                    clip: true;

                    VerticalLayout {
                        HorizontalLayout {
                            vertical-stretch: 1;

                            preview := VideoPreview {
                                horizontal-stretch: 1;
                                has-clip: root.has-clip;
                                frame: root.preview-frame;
                                error-text: root.load-error-text;
                                source-width: root.source-width;
                                source-height: root.source-height;
                                empty-clicked => { root.open-clip-clicked(); }
                            }

                            if root.has-clip: Sidebar {}
                            if !root.has-clip: IntroSidebar {}
                        }

                        if root.has-clip: ScrubberBar {}
                    }
                }
            }
        }
    }

    if ExportDialogState.visible: Rectangle {
        background: #000000.with-alpha(0.4);

        ExportDialog {
            width: 400px;
            height: 220px;
        }
    }
}
