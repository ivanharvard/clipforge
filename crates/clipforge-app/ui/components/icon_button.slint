import { Theme } from "../theme.slint";

// A compact, theme-aware SVG icon button shared by toolbar and panel actions.
//
// Deliberately custom-drawn in every build, including qt-style: Slint's
// native `Button` ignores an explicit width/height smaller than its own
// QStyle-computed minimum size (a QPushButton isn't designed to be squeezed
// into a 28px icon-only slot), so wrapping it here just makes every icon
// button overflow its dock — confirmed by actually rendering it. Slint has
// no native "tool button" style suited to this size, so this stays custom
// for now; only the color palette (Theme) follows KDE's Match System theme.
export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <bool> active: false;
    in property <bool> is-enabled: true;
    callback clicked;

    accessible-role: button;

    width: 28px;
    height: 28px;
    border-radius: Theme.radius-control;
    background: touch.pressed ? Theme.accent-hover : touch.has-hover ? Theme.surface-alt : transparent;
    opacity: is-enabled ? 1.0 : 0.4;
    animate background { duration: 120ms; easing: ease-out; }
    animate opacity { duration: 120ms; easing: ease-out; }

    Image {
        source: root.icon;
        width: 16px;
        height: 16px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        image-fit: contain;
        colorize: active ? Theme.accent : Theme.text-secondary;
        accessible-role: none;
    }

    touch := TouchArea {
        enabled: is-enabled;
        mouse-cursor: is-enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}
