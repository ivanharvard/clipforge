import { Theme } from "../theme.slint";

// A compact icon-only button used for toolbar and panel actions. Renders a
// text glyph today as a placeholder for the custom stroke icon set
// described in DESIGN.md section 6.
export component IconButton inherits Rectangle {
    in property <string> icon-text: "?";
    in property <bool> active: false;
    in property <bool> is-enabled: true;
    callback clicked;

    width: 28px;
    height: 28px;
    border-radius: Theme.radius-control;
    background: touch.pressed ? Theme.accent-hover : touch.has-hover ? Theme.surface-alt : transparent;
    opacity: is-enabled ? 1.0 : 0.4;

    Text {
        text: icon-text;
        color: active ? Theme.accent : Theme.text-secondary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: is-enabled;
        clicked => { root.clicked(); }
    }
}
