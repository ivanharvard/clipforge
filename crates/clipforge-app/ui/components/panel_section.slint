import { Theme } from "../theme.slint";
import { ToolPipelineState } from "../state.slint";

// Shared tool shell. The drag handle and checkbox deliberately own only
// their small hit regions so the rest of the header remains a disclosure.
export component PanelSection inherits Rectangle {
    in property <string> title: "";
    in property <image> icon;
    in property <int> tool-position: 0;
    in property <bool> tool-enabled: true;
    // Owned by ToolPipelineState.items (per-tool, keyed by kind) rather than
    // local component state: the sidebar rebuilds `items` wholesale on every
    // toggle/move/undo, which would otherwise reset a component-local
    // property back to its declared default the moment a tool's index shifts.
    in property <bool> tool-expanded: false;
    callback expand-toggled(bool);
    // Real height of whichever panel currently sits one slot below/above this
    // one, supplied by Sidebar (which owns all five panels as stable, named
    // instances). Lets a single continuous drag walk multiple slots using
    // each neighbor's *actual* height rather than a guessed fixed step.
    in property <length> next-step-height: 1000px;
    in property <length> prev-step-height: 1000px;
    out property <bool> dragging: false;

    background: Theme.surface;
    border-width: 1px;
    border-color: root.dragging ? Theme.accent : transparent;
    opacity: root.tool-enabled ? 1 : 0.72;
    // Sidebar positions the five panels by absolute `y` (so a drag can move
    // them independently of a parent Layout), which means `root` needs an
    // explicit height of its own instead of relying on a parent Layout to
    // size it from LayoutInfo the way a bare Rectangle child normally would.
    height: layout.preferred-height;

    layout := VerticalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;
        padding-top: Theme.space-2;
        spacing: root.tool-expanded && root.tool-enabled ? Theme.space-3 : 0px;

        header := Rectangle {
            height: 40px;

            HorizontalLayout {
                spacing: Theme.space-2;
                // Slint's box layout defaults cross-axis-alignment to Stretch,
                // which pins fixed-size children to the row's *start* edge
                // rather than centering them — hence the checkbox/handle/title
                // sitting at different y-levels despite sharing a 40px row.
                cross-axis-alignment: center;

                drag-handle := Rectangle {
                    // How much of the raw press-to-now delta has already been
                    // "spent" on a step this gesture. Re-basing against this
                    // (instead of a one-shot `handled` latch) is what lets one
                    // continuous press-and-drag walk several slots, Photoshop-
                    // layer style, rather than moving once per press.
                    property <length> consumed: 0px;
                    width: 28px;
                    height: 32px;
                    border-radius: Theme.radius-control;
                    background: (drag-touch.has-hover || root.dragging) ? Theme.surface-alt : transparent;

                    Image {
                        source: @image-url("../../icons/ui/grip-vertical.svg");
                        width: 14px;
                        height: 14px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        colorize: (drag-touch.has-hover || root.dragging) ? Theme.text-primary : Theme.text-secondary;
                    }

                    drag-touch := TouchArea {
                        mouse-cursor: root.dragging ? grabbing : grab;
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.down) {
                                drag-handle.consumed = 0px;
                                root.dragging = true;
                            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                                drag-handle.consumed = 0px;
                                root.dragging = false;
                            }
                        }
                        moved => {
                            if (!root.dragging) {
                                return;
                            }
                            let local-delta = self.mouse-y - self.pressed-y - drag-handle.consumed;
                            if (local-delta > root.next-step-height && root.tool-position < 4) {
                                drag-handle.consumed += root.next-step-height;
                                ToolPipelineState.move-requested(root.tool-position, root.tool-position + 1);
                            } else if (local-delta < -root.prev-step-height && root.tool-position > 0) {
                                drag-handle.consumed -= root.prev-step-height;
                                ToolPipelineState.move-requested(root.tool-position, root.tool-position - 1);
                            }
                        }
                    }
                }

                check := Rectangle {
                    width: 16px;
                    height: 16px;
                    border-radius: 3px;
                    border-width: 1px;
                    border-color: root.tool-enabled ? Theme.accent : Theme.text-secondary;
                    background: root.tool-enabled ? Theme.accent : Theme.surface-alt;

                    Image {
                        visible: root.tool-enabled;
                        source: @image-url("../../icons/ui/check.svg");
                        width: 10px;
                        height: 10px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        colorize: Theme.bg;
                    }

                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { ToolPipelineState.toggle-requested(root.tool-position, !root.tool-enabled); }
                    }
                }

                title-area := Rectangle {
                    horizontal-stretch: 1;
                    height: 32px;

                    HorizontalLayout {
                        spacing: Theme.space-2;
                        cross-axis-alignment: center;

                        Image {
                            source: root.icon;
                            width: 16px;
                            height: 16px;
                            colorize: Theme.text-secondary;
                        }

                        Text {
                            text: root.title;
                            horizontal-stretch: 1;
                            horizontal-alignment: left;
                            font-size: Theme.text-md;
                            font-weight: 600;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                        }
                        Image {
                            source: root.tool-expanded
                                ? @image-url("../../icons/ui/chevron-down.svg")
                                : @image-url("../../icons/ui/chevron-right.svg");
                            width: 14px;
                            height: 14px;
                            colorize: Theme.text-secondary;
                        }
                    }

                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.expand-toggled(!root.tool-expanded); }
                    }
                }
            }
        }

        body-clip := Rectangle {
            clip: true;
            height: root.tool-expanded && root.tool-enabled ? body.preferred-height : 0px;

            body := VerticalLayout {
                width: 100%;
                spacing: Theme.space-3;
                @children
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.border-color;
        }
    }
}
