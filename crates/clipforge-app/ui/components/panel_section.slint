import { Theme } from "../theme.slint";
import { ToolPipelineState } from "../state.slint";

// Shared tool shell. The drag handle and checkbox deliberately own only
// their small hit regions so the rest of the header remains a disclosure.
export component PanelSection inherits Rectangle {
    in property <string> title: "";
    in property <image> icon;
    in property <int> tool-position: 0;
    in property <bool> tool-enabled: true;
    in-out property <bool> expanded: false;

    background: Theme.surface;
    border-width: 0px;
    opacity: root.tool-enabled ? 1 : 0.72;

    VerticalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;
        padding-top: Theme.space-2;
        spacing: root.expanded && root.tool-enabled ? Theme.space-3 : 0px;

        header := Rectangle {
            height: 40px;

            HorizontalLayout {
                spacing: Theme.space-2;
                alignment: center;

                drag-handle := Rectangle {
                    property <bool> handled: false;
                    width: 28px;
                    height: 32px;
                    border-radius: Theme.radius-control;
                    background: drag-touch.has-hover ? Theme.surface-alt : transparent;

                    Text {
                        text: "⠿";
                        color: drag-touch.has-hover ? Theme.text-primary : Theme.text-secondary;
                        font-size: 17px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    drag-touch := TouchArea {
                        mouse-cursor: grab;
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.down) {
                                drag-handle.handled = false;
                            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                                drag-handle.handled = false;
                            }
                        }
                        moved => {
                            if (!drag-handle.handled && self.mouse-y - self.pressed-y > 12px) {
                                drag-handle.handled = true;
                                ToolPipelineState.move-requested(root.tool-position, Math.min(4, root.tool-position + 1));
                            } else if (!drag-handle.handled && self.mouse-y - self.pressed-y < -12px) {
                                drag-handle.handled = true;
                                ToolPipelineState.move-requested(root.tool-position, Math.max(0, root.tool-position - 1));
                            }
                        }
                    }
                }

                check := Rectangle {
                    width: 16px;
                    height: 16px;
                    border-radius: 3px;
                    border-width: 1px;
                    border-color: root.tool-enabled ? Theme.accent : Theme.text-secondary;
                    background: root.tool-enabled ? Theme.accent : Theme.surface-alt;

                    Text {
                        visible: root.tool-enabled;
                        text: "✓";
                        color: Theme.bg;
                        font-size: 12px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { ToolPipelineState.toggle-requested(root.tool-position, !root.tool-enabled); }
                    }
                }

                title-area := Rectangle {
                    horizontal-stretch: 1;
                    height: 32px;

                    HorizontalLayout {
                        spacing: Theme.space-2;
                        alignment: center;

                        Rectangle {
                            width: 18px;
                            height: 18px;
                            Image {
                                source: root.icon;
                                width: 16px;
                                height: 16px;
                                x: 1px;
                                y: 1px;
                                colorize: Theme.text-secondary;
                            }
                        }

                        Text {
                            text: root.title;
                            horizontal-stretch: 1;
                            horizontal-alignment: left;
                            font-size: Theme.text-md;
                            font-weight: 600;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                        }
                        Image {
                            source: root.expanded
                                ? @image-url("../../icons/ui/chevron-down.svg")
                                : @image-url("../../icons/ui/chevron-right.svg");
                            width: 14px;
                            height: 14px;
                            colorize: Theme.text-secondary;
                        }
                    }

                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.expanded = !root.expanded; }
                    }
                }
            }
        }

        body-clip := Rectangle {
            clip: true;
            height: root.expanded && root.tool-enabled ? body.preferred-height : 0px;

            body := VerticalLayout {
                width: 100%;
                spacing: Theme.space-3;
                @children
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.border-color;
        }
    }
}
