import { Theme } from "../theme.slint";

// Shared shell for the 5 sidebar panels: a clickable header (disclosure
// glyph + icon + title) that toggles a body containing whatever the
// concrete panel declares as children. Each panel collapses independently
// (DESIGN.md section 9) — there's no accordion/exclusivity between them.
export component PanelSection inherits Rectangle {
    in property <string> title: "";
    in property <image> icon;
    in-out property <bool> expanded: true;

    background: Theme.surface;
    border-radius: Theme.radius-panel;
    border-width: 1px;
    border-color: header-touch.has-hover ? Theme.accent.with-alpha(0.65) : Theme.border-color;
    animate border-color { duration: 120ms; easing: ease-out; }

    VerticalLayout {
        padding: Theme.space-4;
        spacing: root.expanded ? Theme.space-3 : 0px;

        header := HorizontalLayout {
            spacing: Theme.space-2;

            Image {
                source: root.expanded
                    ? @image-url("../../icons/ui/chevron-down.svg")
                    : @image-url("../../icons/ui/chevron-right.svg");
                width: 14px;
                height: 14px;
                colorize: Theme.text-secondary;
            }

            Image {
                source: root.icon;
                width: 16px;
                height: 16px;
                colorize: Theme.text-secondary;
            }

            Text {
                text: root.title;
                font-size: Theme.text-md;
                font-weight: 600;
                color: Theme.text-primary;
                vertical-alignment: center;
            }

            header-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.expanded = !root.expanded; }
            }
        }

        body-clip := Rectangle {
            clip: true;
            height: root.expanded ? body.preferred-height : 0px;

            body := VerticalLayout {
                width: 100%;
                spacing: Theme.space-3;
                @children
            }
        }
    }
}
