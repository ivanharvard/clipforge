import { Theme } from "../theme.slint";

// Custom-drawn radio-style option row, not std-widgets RadioButton: Slint
// 1.17's "qt" style implements RadioButton as a hand-drawn component with
// hardcoded light-theme colors rather than a real native QStyle-painted
// item (unlike Button/CheckBox/ComboBox/Slider/SpinBox/LineEdit, which all
// use genuine Native* items and correctly follow the live palette) — so it
// never contrasts correctly against a dark dialog, and its RadioGroup's
// internal exclusive-selection bookkeeping fights an externally-driven
// `checked` binding badly enough to desync the selection. This sidesteps
// both problems: plain Theme-token colors and fully external state.
export component RadioOption inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked;

    height: 32px;
    border-radius: Theme.radius-control;
    background: touch.has-hover ? Theme.surface-alt : transparent;

    HorizontalLayout {
        padding-left: Theme.space-2;
        padding-right: Theme.space-2;
        spacing: Theme.space-2;
        cross-axis-alignment: center;

        Rectangle {
            width: 16px;
            height: 16px;
            border-radius: 8px;
            border-width: 1px;
            border-color: root.selected ? Theme.accent : Theme.text-secondary;

            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Theme.accent;
                opacity: root.selected ? 1.0 : 0.0;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                animate opacity { duration: 100ms; easing: ease-out; }
            }
        }

        Text {
            text: root.label;
            color: Theme.text-primary;
            font-size: Theme.text-sm;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}
