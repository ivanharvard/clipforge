// Compact branded command bar matching the ClipForge web editor.
import { Theme } from "../theme.slint";
import { IconButton } from "icon_button.slint";

export component TitleBar inherits Rectangle {
    callback undo-clicked;
    callback redo-clicked;
    in property <bool> can-undo: false;
    in property <bool> can-redo: false;

    height: Theme.space-8 + Theme.space-6;
    background: Theme.bg;
    border-width: 1px;
    border-color: Theme.border-color;

    HorizontalLayout {
        padding-left: Theme.space-4;
        padding-right: Theme.space-4;
        spacing: Theme.space-3;

        Rectangle {
            width: Theme.space-8;
            height: Theme.space-8;
            Image {
                source: @image-url("../../icons/src/app-icon.svg");
                width: 28px;
                height: 28px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                image-fit: contain;
            }
        }

        Text {
            text: "ClipForge";
            color: Theme.text-primary;
            font-size: Theme.text-md;
            font-weight: 700;
            vertical-alignment: center;
        }

        IconButton {
            icon: @image-url("../../icons/ui/undo-2.svg");
            accessible-label: "Undo";
            is-enabled: root.can-undo;
            clicked => { root.undo-clicked(); }
        }

        IconButton {
            icon: @image-url("../../icons/ui/redo-2.svg");
            accessible-label: "Redo";
            is-enabled: root.can-redo;
            clicked => { root.redo-clicked(); }
        }

        Rectangle {}

    }
}
