import { Theme } from "../theme.slint";
import { IconButton } from "icon_button.slint";

// One compact custom title bar, flush with the window edge, used on both
// Windows and Linux instead of native window chrome (DESIGN.md section 7).
export component TitleBar inherits Rectangle {
    callback open-clip-clicked;
    callback export-clicked;
    callback minimize-clicked;
    callback maximize-clicked;
    callback close-clicked;

    height: 36px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border-color;

    HorizontalLayout {
        padding-left: Theme.space-4;
        padding-right: Theme.space-2;
        spacing: Theme.space-3;

        Text {
            text: "Open Clip";
            color: Theme.text-primary;
            font-size: Theme.text-sm;
            vertical-alignment: center;

            TouchArea {
                clicked => { root.open-clip-clicked(); }
            }
        }

        Rectangle {}

        Text {
            text: "Export";
            color: Theme.accent;
            font-size: Theme.text-sm;
            vertical-alignment: center;

            TouchArea {
                clicked => { root.export-clicked(); }
            }
        }

        IconButton { icon-text: "—"; clicked => { root.minimize-clicked(); } }
        IconButton { icon-text: "▢"; clicked => { root.maximize-clicked(); } }
        IconButton { icon-text: "✕"; clicked => { root.close-clicked(); } }
    }
}
