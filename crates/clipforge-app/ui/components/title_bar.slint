import { Theme } from "../theme.slint";
import { IconButton } from "icon_button.slint";

// One compact custom title bar, flush with the window edge, carrying the
// app's own actions (DESIGN.md section 7). Window controls (minimize/
// maximize/close) are native OS chrome, not drawn here.
export component TitleBar inherits Rectangle {
    callback open-clip-clicked;
    callback export-clicked;
    callback undo-clicked;
    callback redo-clicked;
    in property <bool> can-undo: false;
    in property <bool> can-redo: false;

    height: 36px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border-color;

    HorizontalLayout {
        padding-left: Theme.space-4;
        padding-right: Theme.space-4;
        spacing: Theme.space-3;

        Text {
            text: "Open Clip";
            color: Theme.text-primary;
            font-size: Theme.text-sm;
            vertical-alignment: center;

            TouchArea {
                clicked => { root.open-clip-clicked(); }
            }
        }

        IconButton {
            icon-text: "↶";
            is-enabled: root.can-undo;
            clicked => { root.undo-clicked(); }
        }

        IconButton {
            icon-text: "↷";
            is-enabled: root.can-redo;
            clicked => { root.redo-clicked(); }
        }

        Rectangle {}

        Text {
            text: "Export";
            color: Theme.accent;
            font-size: Theme.text-sm;
            vertical-alignment: center;

            TouchArea {
                clicked => { root.export-clicked(); }
            }
        }
    }
}
