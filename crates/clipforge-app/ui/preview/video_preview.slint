import { Theme } from "../theme.slint";
import { CropState } from "../state.slint";
import { CropOverlay } from "crop_overlay.slint";

// Displays the current decoded frame (pushed in from Rust via
// `video_surface.rs`) letterboxed against the surface background, or an
// empty-state message when no clip is loaded.
export component VideoPreview inherits Rectangle {
    in property <image> frame;
    in property <bool> has-clip: false;
    in property <string> error-text: "";
    in property <int> source-width: 1;
    in property <int> source-height: 1;

    background: Theme.surface;
    border-radius: Theme.radius-panel;

    if !root.has-clip: VerticalLayout {
        alignment: center;
        spacing: Theme.space-2;

        Text {
            text: "Open a clip to begin";
            color: Theme.text-secondary;
            font-size: Theme.text-sm;
            horizontal-alignment: center;
        }

        if root.error-text != "": Text {
            text: root.error-text;
            color: Theme.danger;
            font-size: Theme.text-xs;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }

    if root.has-clip: Image {
        source: root.frame;
        image-fit: contain;
        width: 100%;
        height: 100%;
    }

    if root.has-clip && CropState.tool-active: CropOverlay {
        width: 100%;
        height: 100%;
        source-width: root.source-width;
        source-height: root.source-height;
    }
}
