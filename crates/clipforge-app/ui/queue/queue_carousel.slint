import { Theme } from "../theme.slint";
import { QueueItem } from "../state.slint";
import { IconButton } from "../components/icon_button.slint";

component TextButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> primary: false;
    in property <bool> is-enabled: true;
    callback clicked;

    height: 36px;
    min-width: 84px;
    border-radius: Theme.radius-control;
    border-width: root.primary ? 0px : 1px;
    border-color: Theme.border-color;
    background: root.primary
        ? (touch.has-hover ? Theme.accent-hover : Theme.accent)
        : (touch.has-hover ? Theme.surface-alt : Theme.surface);
    opacity: root.is-enabled ? 1 : 0.45;

    HorizontalLayout {
        padding-left: Theme.space-4;
        padding-right: Theme.space-4;
        alignment: center;
        cross-axis-alignment: center;

        Text {
            text: root.label;
            color: root.primary ? Theme.bg : Theme.text-primary;
            font-size: Theme.text-sm;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.is-enabled;
        mouse-cursor: self.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

component ExportMenuRow inherits Rectangle {
    in property <string> label: "";
    callback clicked;

    height: 32px;
    background: touch.has-hover ? Theme.surface-alt : transparent;

    Text {
        x: Theme.space-3;
        text: root.label;
        color: Theme.text-primary;
        font-size: Theme.text-sm;
        vertical-alignment: center;
        height: 100%;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component QueueCard inherits Rectangle {
    in property <string> label: "";
    in property <string> position: "";
    in property <bool> active: false;
    callback clicked;

    min-width: 164px;
    max-width: 164px;
    height: 40px;
    border-radius: Theme.radius-control;
    border-width: 1px;
    border-color: root.active ? Theme.accent : Theme.border-color;
    background: root.active ? Theme.accent.with-alpha(0.12) : touch.has-hover ? Theme.surface-alt : Theme.surface;

    HorizontalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;
        spacing: Theme.space-2;
        cross-axis-alignment: center;

        VerticalLayout {
            alignment: center;

            Rectangle {
                width: 7px;
                height: 7px;
                border-radius: 4px;
                background: root.active ? Theme.accent : Theme.text-secondary;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 0px;
            Text {
                text: root.label;
                color: Theme.text-primary;
                font-size: Theme.text-xs;
                overflow: elide;
            }
            Text {
                text: root.position;
                color: Theme.text-secondary;
                font-size: 9px;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component QueueCarousel inherits Rectangle {
    in property <[QueueItem]> items;
    in property <int> count: 0;
    in property <int> active-index: -1;
    in property <bool> can-previous: false;
    in property <bool> can-next: false;
    callback add-clicked;
    callback export-clicked;
    callback export-current-clicked;
    callback remove-clicked;
    callback select-clicked(int);
    callback previous-clicked;
    callback next-clicked;

    height: 64px;
    background: Theme.surface;
    border-radius: Theme.radius-panel;
    border-width: 1px;
    border-color: Theme.border-color;

    add-button := TextButton {
        x: Theme.space-3;
        y: (parent.height - self.height) / 2;
        width: 128px;
        label: root.count > 0 ? "Add videos  ·  " + root.count : "Add videos";
        clicked => { root.add-clicked(); }
    }

    action-row := Rectangle {
        x: parent.width - self.width - Theme.space-3;
        y: (parent.height - self.height) / 2;
        height: 40px;
        // A bare Rectangle with no explicit width and no Layout managing it
        // defaults to filling its parent — which is why dropping the old
        // hardcoded `width: 192px` made this balloon across the whole bar
        // instead of just fitting its content. Size it to the row's actual
        // preferred width instead of guessing a fixed number.
        width: row.preferred-width;

        row := HorizontalLayout {
            spacing: Theme.space-2;
            cross-axis-alignment: center;

            IconButton {
                icon: @image-url("../../icons/ui/chevron-left.svg");
                accessible-label: "Previous queued video";
                is-enabled: root.can-previous;
                clicked => { root.previous-clicked(); }
            }
            IconButton {
                icon: @image-url("../../icons/ui/chevron-right.svg");
                accessible-label: "Next queued video";
                is-enabled: root.can-next;
                clicked => { root.next-clicked(); }
            }
            IconButton {
                icon: @image-url("../../icons/ui/x.svg");
                accessible-label: "Remove current video from queue";
                is-enabled: root.count > 0;
                clicked => { root.remove-clicked(); }
            }
            export-button := TextButton {
                label: root.count > 1 ? "Export ▾" : "Export video";
                primary: true;
                is-enabled: root.count > 0;
                clicked => {
                    if (root.count > 1) {
                        export-popup.show();
                    } else {
                        root.export-clicked();
                    }
                }
            }
        }

        export-popup := PopupWindow {
            // Right-align with the button (rather than left-align) since
            // the button sits at the far right edge of the carousel bar —
            // a wider popup left-aligned there would run off the window.
            x: export-button.x + export-button.width - self.width;
            y: export-button.y + export-button.height + Theme.space-1;
            width: 190px;
            height: 64px;

            Rectangle {
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.border-color;
                border-radius: Theme.radius-control;
                clip: true;

                VerticalLayout {
                    ExportMenuRow {
                        label: "Export This Video";
                        clicked => { root.export-current-clicked(); }
                    }
                    ExportMenuRow {
                        label: "Export All";
                        clicked => { root.export-clicked(); }
                    }
                }
            }
        }
    }

    queue-strip := Rectangle {
        x: add-button.x + add-button.width + Theme.space-2;
        y: (parent.height - self.height) / 2;
        width: Math.max(0px, action-row.x - Theme.space-2 - self.x);
        height: 40px;
        clip: true;

        property <length> card-stride: 164px + Theme.space-2;
        // Center of the active card, measured from the strip's own left edge.
        property <length> active-card-center: root.active-index >= 0
            ? root.active-index * card-stride + 82px
            : self.width / 2;
        property <length> content-width: Math.max(0px, root.count * card-stride - Theme.space-2);
        property <length> max-scroll: Math.max(0px, content-width - self.width);
        // Clamp so we never scroll past either end of the strip just to
        // center a card near an edge.
        property <length> scroll-offset: Math.max(0px, Math.min(active-card-center - self.width / 2, max-scroll));

        track := HorizontalLayout {
            x: -queue-strip.scroll-offset;
            height: parent.height;
            spacing: Theme.space-2;
            alignment: start;
            animate x { duration: 200ms; easing: ease-out; }

            for item in root.items: QueueCard {
                label: item.name;
                position: "Video " + (item.index + 1) + " of " + root.count;
                active: item.active;
                clicked => { root.select-clicked(item.index); }
            }
        }
    }
}
