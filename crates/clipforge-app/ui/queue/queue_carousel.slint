import { Theme } from "../theme.slint";
import { QueueItem } from "../state.slint";
import { IconButton } from "../components/icon_button.slint";

component TextButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> primary: false;
    in property <bool> is-enabled: true;
    callback clicked;

    height: 36px;
    min-width: 84px;
    border-radius: Theme.radius-control;
    border-width: root.primary ? 0px : 1px;
    border-color: Theme.border-color;
    background: root.primary
        ? (touch.has-hover ? Theme.accent-hover : Theme.accent)
        : (touch.has-hover ? Theme.surface-alt : Theme.surface);
    opacity: root.is-enabled ? 1 : 0.45;

    HorizontalLayout {
        padding-left: Theme.space-4;
        padding-right: Theme.space-4;
        alignment: center;

        Text {
            text: root.label;
            color: root.primary ? Theme.bg : Theme.text-primary;
            font-size: Theme.text-sm;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.is-enabled;
        mouse-cursor: self.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

component QueueCard inherits Rectangle {
    in property <string> label: "";
    in property <string> position: "";
    in property <bool> active: false;
    callback clicked;

    min-width: 164px;
    max-width: 164px;
    height: 40px;
    border-radius: Theme.radius-control;
    border-width: 1px;
    border-color: root.active ? Theme.accent : Theme.border-color;
    background: root.active ? Theme.accent.with-alpha(0.12) : touch.has-hover ? Theme.surface-alt : Theme.surface;

    HorizontalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;
        spacing: Theme.space-2;

        VerticalLayout {
            alignment: center;

            Rectangle {
                width: 7px;
                height: 7px;
                border-radius: 4px;
                background: root.active ? Theme.accent : Theme.text-secondary;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 0px;
            Text {
                text: root.label;
                color: Theme.text-primary;
                font-size: Theme.text-xs;
                overflow: elide;
            }
            Text {
                text: root.position;
                color: Theme.text-secondary;
                font-size: 9px;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component QueueCarousel inherits Rectangle {
    in property <[QueueItem]> items;
    in property <int> count: 0;
    in property <bool> can-previous: false;
    in property <bool> can-next: false;
    callback add-clicked;
    callback export-clicked;
    callback remove-clicked;
    callback select-clicked(int);
    callback previous-clicked;
    callback next-clicked;

    height: 64px;
    background: Theme.surface;
    border-radius: Theme.radius-panel;
    border-width: 1px;
    border-color: Theme.border-color;

    add-button := TextButton {
        x: Theme.space-3;
        y: (parent.height - self.height) / 2;
        width: 128px;
        label: root.count > 0 ? "Add videos  ·  " + root.count : "Add videos";
        clicked => { root.add-clicked(); }
    }

    action-row := Rectangle {
        x: parent.width - self.width - Theme.space-3;
        y: (parent.height - self.height) / 2;
        width: 192px;
        height: 40px;

        HorizontalLayout {
            spacing: Theme.space-2;

            IconButton {
                icon: @image-url("../../icons/ui/chevron-left.svg");
                accessible-label: "Previous queued video";
                is-enabled: root.can-previous;
                clicked => { root.previous-clicked(); }
            }
            IconButton {
                icon: @image-url("../../icons/ui/chevron-right.svg");
                accessible-label: "Next queued video";
                is-enabled: root.can-next;
                clicked => { root.next-clicked(); }
            }
            IconButton {
                icon: @image-url("../../icons/ui/x.svg");
                accessible-label: "Remove current video from queue";
                is-enabled: root.count > 0;
                clicked => { root.remove-clicked(); }
            }
            TextButton {
                label: root.count > 1 ? "Export queue" : "Export video";
                primary: true;
                is-enabled: root.count > 0;
                clicked => { root.export-clicked(); }
            }
        }
    }

    queue-strip := Rectangle {
        x: add-button.x + add-button.width + Theme.space-2;
        y: (parent.height - self.height) / 2;
        width: Math.max(0px, action-row.x - Theme.space-2 - self.x);
        height: 40px;
        clip: true;

        HorizontalLayout {
            width: parent.width;
            height: parent.height;
            spacing: Theme.space-2;
            alignment: start;
            for item in root.items: QueueCard {
                label: item.name;
                position: "Video " + (item.index + 1) + " of " + root.count;
                active: item.active;
                clicked => { root.select-clicked(item.index); }
            }
        }
    }
}
