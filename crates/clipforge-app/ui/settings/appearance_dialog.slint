import { Theme } from "../theme.slint";
import { AppearanceState, PersistenceSettingsState, ShortcutsState } from "../state.slint";
import { RadioOption } from "../components/radio_option.slint";
import { KeyCaptureField } from "../components/key_capture_field.slint";
import { Button, ScrollView } from "std-widgets.slint";

component TabButton inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked;

    height: 30px;
    border-radius: Theme.radius-control;
    background: root.selected ? Theme.accent.with-alpha(0.16) : (touch.has-hover ? Theme.surface-alt : transparent);

    Text {
        text: root.label;
        color: root.selected ? Theme.accent : Theme.text-secondary;
        font-size: Theme.text-sm;
        font-weight: root.selected ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Persistence row for one tool: a label plus a 3-way choice of when its
// edits carry over (app restart / new videos this session / never).
component PersistenceRow inherits VerticalLayout {
    in property <string> kind;
    in property <string> label;
    in property <int> mode-index;

    spacing: Theme.space-1;

    Text {
        text: root.label;
        color: Theme.text-primary;
        font-size: Theme.text-sm;
        font-weight: 600;
    }

    RadioOption {
        label: "Persist across app restart";
        selected: root.mode-index == 0;
        clicked => { PersistenceSettingsState.mode-selected(root.kind, 0); }
    }
    RadioOption {
        label: "Persist to new videos this session only";
        selected: root.mode-index == 1;
        clicked => { PersistenceSettingsState.mode-selected(root.kind, 1); }
    }
    RadioOption {
        label: "Never persist (always default)";
        selected: root.mode-index == 2;
        clicked => { PersistenceSettingsState.mode-selected(root.kind, 2); }
    }
}

// Settings dialog: Appearance (theme palette, KDE native-style status) and
// Defaults (per-tool persistence mode) tabs.
export component SettingsDialog inherits Rectangle {
    background: Theme.surface;
    border-radius: Theme.radius-panel;
    border-width: 1px;
    border-color: Theme.border-color;
    clip: true;

    VerticalLayout {
        padding: Theme.space-6;
        spacing: Theme.space-4;

        Text {
            text: "Settings";
            font-size: Theme.text-lg;
            font-weight: 600;
            color: Theme.text-primary;
        }

        HorizontalLayout {
            spacing: Theme.space-2;

            TabButton {
                label: "Appearance";
                selected: AppearanceState.active-tab == 0;
                clicked => { AppearanceState.active-tab = 0; scroll.viewport-y = 0px; }
            }
            TabButton {
                label: "Defaults";
                selected: AppearanceState.active-tab == 1;
                clicked => { AppearanceState.active-tab = 1; scroll.viewport-y = 0px; }
            }
            TabButton {
                label: "Shortcuts";
                selected: AppearanceState.active-tab == 2;
                clicked => { AppearanceState.active-tab = 2; scroll.viewport-y = 0px; }
            }
            Rectangle {}
        }

        // Scrollable so a growing tab body (e.g. five tools' worth of
        // persistence rows) never pushes the Close button below the
        // dialog's visible bounds — only this region scrolls. Both tabs
        // share one Flickable/viewport, so its scroll offset is reset
        // above on every tab switch — otherwise the new tab would open
        // wherever the previous tab happened to be scrolled to.
        scroll := ScrollView {
            vertical-stretch: 1;
            // Slint doesn't reliably auto-derive a ScrollView's scrollable
            // range from a Layout child nested this deeply (conditional
            // VerticalLayouts inside a VerticalLayout inside the
            // ScrollView) — it under-reports the content height, so the
            // scrollbar bottoms out before the last row is fully visible.
            // Binding viewport-height explicitly to the content's own
            // preferred-height (the same fix sidebar.slint already uses
            // for the tool panel list) makes the real range available.
            viewport-height: content.preferred-height;

            content := VerticalLayout {
                width: 100%;
                spacing: Theme.space-4;

                if AppearanceState.active-tab == 0: VerticalLayout {
                    spacing: Theme.space-4;

                    VerticalLayout {
                        spacing: Theme.space-1;

                        RadioOption {
                            label: "Dark";
                            selected: AppearanceState.theme-mode-index == 0;
                            clicked => { AppearanceState.theme-mode-selected(0); }
                        }

                        RadioOption {
                            label: "Light";
                            selected: AppearanceState.theme-mode-index == 1;
                            clicked => { AppearanceState.theme-mode-selected(1); }
                        }

                        RadioOption {
                            label: "Match system";
                            selected: AppearanceState.theme-mode-index == 2;
                            clicked => { AppearanceState.theme-mode-selected(2); }
                        }
                    }

                    // Manually broken at ~fit-width instead of `wrap:
                    // word-wrap`: Slint's Text keeps its unwrapped
                    // single-line preferred-height even when wrap is on
                    // (only min-width shrinks), which under-reports the
                    // height this ScrollView sums up for its scroll range.
                    // Explicit line breaks don't have that problem — only
                    // wrap-induced ones are excluded from preferred-height.
                    if AppearanceState.native-style-available: Text {
                        text: "Using native KDE Application Style for controls\n(configured in KDE System Settings).";
                        color: Theme.text-secondary;
                        font-size: Theme.text-xs;
                    }

                    if AppearanceState.kde-detected: Text {
                        text: "For native KDE-styled controls, install the\nclipforge-kde package.";
                        color: Theme.text-secondary;
                        font-size: Theme.text-xs;
                    }
                }

                if AppearanceState.active-tab == 1: VerticalLayout {
                    spacing: Theme.space-4;

                    Text {
                        text: "Controls whether a tool's edits carry over to\nthe next video you add, or across an app\nrestart.";
                        color: Theme.text-secondary;
                        font-size: Theme.text-xs;
                    }

                    for row in PersistenceSettingsState.rows: PersistenceRow {
                        kind: row.kind;
                        label: row.label;
                        mode-index: row.mode-index;
                    }
                }

                if AppearanceState.active-tab == 2: VerticalLayout {
                    spacing: Theme.space-2;

                    Text {
                        text: "Click a shortcut, then press a key\n(with optional Ctrl/Shift/Alt) or click a\nmouse button. Press Escape to leave it\nunchanged.";
                        color: Theme.text-secondary;
                        font-size: Theme.text-xs;
                    }

                    for row[index] in ShortcutsState.rows: KeyCaptureField {
                        label: row.label;
                        binding-text: row.binding-text;
                        listening: ShortcutsState.listening-index == index;
                        clicked => { ShortcutsState.row-clicked(index); }
                    }
                }
            }
        }

        // Its own fixed footer item, outside the scroll area, so it's
        // always visible regardless of how tall the tab content grows.
        HorizontalLayout {
            alignment: end;
            spacing: Theme.space-2;

            if AppearanceState.active-tab == 2: Button {
                text: "Reset to Defaults";
                clicked => { ShortcutsState.reset-defaults-clicked(); }
            }

            Button {
                text: "Close";
                primary: true;
                clicked => { AppearanceState.close-clicked(); }
            }
        }
    }
}
