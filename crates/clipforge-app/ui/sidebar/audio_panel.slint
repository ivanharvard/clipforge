import { Theme } from "../theme.slint";
import { AudioState } from "../state.slint";
import { PanelSection } from "../components/panel_section.slint";
import { IconButton } from "../components/icon_button.slint";
import { LabeledSlider } from "../components/labeled_slider.slint";
import { ComboBox, CheckBox } from "std-widgets.slint";

export component AudioPanel inherits PanelSection {
    title: "Audio";
    icon: @image-url("../../icons/ui/audio-lines.svg");

    HorizontalLayout {
        spacing: Theme.space-2;
        cross-axis-alignment: center;

        LabeledSlider {
            horizontal-stretch: 1;
            label: "Volume";
            value-text: "\{Math.round(AudioState.volume * 100)}%";
            minimum: 0;
            maximum: 2;
            value: AudioState.volume;
            changed(v) => {
                AudioState.volume = v;
                AudioState.volume-changed(v);
            }
        }

        IconButton {
            icon: AudioState.muted
                ? @image-url("../../icons/ui/volume-x.svg")
                : @image-url("../../icons/ui/volume-2.svg");
            accessible-label: AudioState.muted ? "Unmute audio" : "Mute audio";
            active: AudioState.muted;
            clicked => { AudioState.mute-toggled(); }
        }
    }

    ComboBox {
        enabled: !AudioState.merge-tracks;
        model: AudioState.tracks;
        current-index: AudioState.track-index;
        selected(_) => {
            AudioState.track-index = self.current-index;
            AudioState.track-selected(self.current-index);
        }
    }

    CheckBox {
        text: "Merge all tracks into one";
        checked: AudioState.merge-tracks;
        toggled => {
            AudioState.merge-tracks = self.checked;
            AudioState.merge-tracks-toggled();
        }
    }

    Text {
        text: "Mixes every audio track in the source down into a single track, instead of exporting only the one picked above.";
        color: Theme.text-secondary;
        font-size: Theme.text-xs;
        wrap: word-wrap;
    }

    CheckBox {
        text: "Normalize audio";
        checked: AudioState.normalize;
        toggled => {
            AudioState.normalize = self.checked;
            AudioState.normalize-toggled();
        }
    }

    Text {
        text: "Evens out loudness on the exported audio (the merged mix, or the track selected above) — doesn't combine tracks.";
        color: Theme.text-secondary;
        font-size: Theme.text-xs;
        wrap: word-wrap;
    }
}
