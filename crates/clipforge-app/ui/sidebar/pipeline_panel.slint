import { Theme } from "../theme.slint";
import { PipelineState } from "../state.slint";
import { PanelSection } from "../components/panel_section.slint";
import { IconButton } from "../components/icon_button.slint";
import { CheckBox } from "std-widgets.slint";

export component PipelinePanel inherits PanelSection {
    title: "Pipeline";
    icon: @image-url("../../icons/ui/list-end.svg");

    Text {
        text: "Choose the steps used during export and arrange your workflow.";
        color: Theme.text-secondary;
        font-size: Theme.text-xs;
        wrap: word-wrap;
    }

    for stage[index] in PipelineState.stages: Rectangle {
        height: 32px;
        border-radius: Theme.radius-control;
        background: Theme.surface-alt;

        HorizontalLayout {
            padding-left: Theme.space-2;
            padding-right: Theme.space-1;
            spacing: Theme.space-1;

            CheckBox {
                text: stage.label;
                checked: stage.enabled;
                horizontal-stretch: 1;
                toggled => { PipelineState.enabled-changed(index, self.checked); }
            }

            IconButton {
                icon: @image-url("../../icons/ui/move-up.svg");
                accessible-label: "Move stage up";
                is-enabled: index > 0;
                clicked => { PipelineState.move-up-clicked(index); }
            }

            IconButton {
                icon: @image-url("../../icons/ui/move-down.svg");
                accessible-label: "Move stage down";
                is-enabled: index + 1 < PipelineState.stages.length;
                clicked => { PipelineState.move-down-clicked(index); }
            }
        }
    }
}
