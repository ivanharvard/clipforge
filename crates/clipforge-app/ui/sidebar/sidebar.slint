import { Theme } from "../theme.slint";
import { ToolPipelineState } from "../state.slint";
import { ScrollView } from "std-widgets.slint";
import { TransformPanel } from "transform_panel.slint";
import { CropPanel } from "crop_panel.slint";
import { ResolutionPanel } from "resolution_panel.slint";
import { AudioPanel } from "audio_panel.slint";
import { CompressPanel } from "compress_panel.slint";

export component Sidebar inherits Rectangle {
    width: 320px;
    background: Theme.surface;

    scroll := ScrollView {
        VerticalLayout {
            width: scroll.visible-width;
            padding-right: 14px;
            spacing: 0px;

            for tool[index] in ToolPipelineState.items: VerticalLayout {
                if tool.kind == "compress": CompressPanel {
                    tool-position: index;
                    tool-enabled: tool.enabled;
                    tool-expanded: tool.expanded;
                    expand-toggled(value) => { ToolPipelineState.expand-toggle-requested(index, value); }
                }
                if tool.kind == "transform": TransformPanel {
                    tool-position: index;
                    tool-enabled: tool.enabled;
                    tool-expanded: tool.expanded;
                    expand-toggled(value) => { ToolPipelineState.expand-toggle-requested(index, value); }
                }
                if tool.kind == "crop": CropPanel {
                    tool-position: index;
                    tool-enabled: tool.enabled;
                    tool-expanded: tool.expanded;
                    expand-toggled(value) => { ToolPipelineState.expand-toggle-requested(index, value); }
                }
                if tool.kind == "resolution": ResolutionPanel {
                    tool-position: index;
                    tool-enabled: tool.enabled;
                    tool-expanded: tool.expanded;
                    expand-toggled(value) => { ToolPipelineState.expand-toggle-requested(index, value); }
                }
                if tool.kind == "audio": AudioPanel {
                    tool-position: index;
                    tool-enabled: tool.enabled;
                    tool-expanded: tool.expanded;
                    expand-toggled(value) => { ToolPipelineState.expand-toggle-requested(index, value); }
                }
            }
        }
    }
}
