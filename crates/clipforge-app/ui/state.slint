// Cross-cutting state exposed as Slint globals, per the "Key data flow"
// section of the project's implementation plan: nested component instances
// (panels, scrubber bar, export dialog) aren't reachable from the
// generated Rust `App` API directly, so anything Rust needs to read or
// drive lives here instead, and the components below bind straight to it.

export struct ToolItem {
    kind: string,
    enabled: bool,
    expanded: bool,
}

export struct QueueItem {
    name: string,
    index: int,
    active: bool,
}

export global PlaybackState {
    in-out property <string> current-time-text: "00:00:00.00";
    in-out property <string> duration-text: "00:00:00.00";
    in-out property <string> in-point-time-text: "00:00:00.00";
    in-out property <string> out-point-time-text: "00:00:00.00";
    in-out property <float> playhead-position: 0;
    in-out property <float> in-point-position: 0;
    in-out property <float> out-point-position: 1;
    in-out property <bool> playing: false;

    callback play-pause-clicked();
    callback seek-requested(float);
    // Fired once on pointer release after a scrub drag (or a plain click)
    // to request a precise, frame-accurate seek — seek-requested fires
    // continuously during the drag for cheap live feedback instead.
    callback seek-committed(float);
    callback in-point-drag-requested(float);
    callback out-point-drag-requested(float);
    callback in-point-text-submitted(string);
    callback out-point-text-submitted(string);
    // Fired once when an in/out handle drag starts (not per move event) so
    // Rust can push exactly one undo snapshot per drag.
    callback trim-drag-started();
}

export global TransformState {
    in-out property <int> rotation-degrees: 0;
    in-out property <bool> flip-horizontal: false;
    in-out property <bool> flip-vertical: false;

    callback rotate-clockwise-clicked();
    callback rotate-counter-clockwise-clicked();
    callback flip-horizontal-toggled();
    callback flip-vertical-toggled();
    callback reset-clicked();
}

export global CropState {
    in-out property <int> x: 0;
    in-out property <int> y: 0;
    in-out property <int> width: 0;
    in-out property <int> height: 0;
    in-out property <bool> aspect-locked: false;
    in-out property <bool> tool-active: false;

    callback changed();
    // Fired once per discrete edit (one field commit, or the start of an
    // on-canvas drag) — never per-move during a drag — so Rust can push
    // exactly one undo snapshot per user action rather than one per event.
    callback snapshot-requested();
    callback aspect-lock-toggled();
    callback reset-clicked();
    callback tool-active-changed(bool);
}

export global ResolutionState {
    in property <[string]> presets: ["Keep current", "1080p", "720p", "480p", "Custom"];
    in-out property <int> preset-index: 0;
    in-out property <int> custom-width: 1920;
    in-out property <int> custom-height: 1080;
    in-out property <bool> aspect-locked: true;
    in-out property <bool> custom-fields-enabled: false;

    callback preset-selected(int);
    callback custom-size-changed();
    callback aspect-lock-toggled();
}

export global AudioState {
    in-out property <float> volume: 1.0;
    in-out property <bool> muted: false;
    in property <[string]> tracks: ["Track 1"];
    in-out property <int> track-index: 0;
    in-out property <bool> normalize: false;
    in-out property <bool> merge-tracks: false;

    callback volume-changed(float);
    callback mute-toggled();
    callback track-selected(int);
    callback normalize-toggled();
    callback merge-tracks-toggled();
}

export global CompressState {
    in-out property <int> target-size-mb: 10;
    // Whether the advanced quality-mode picker (below) is shown at all;
    // off, the panel always behaves as Target Size mode.
    in-out property <bool> advanced-mode: false;
    // 0 = Target Size (MiB), 1 = Target Bitrate (kbps), 2 = CRF (quality).
    in-out property <int> mode-index: 0;
    in-out property <int> target-bitrate-kbps: 8000;
    in-out property <int> crf-value: 23;
    in property <[string]> frame-rate-options: ["Automatic", "30 FPS", "60 FPS"];
    in-out property <int> frame-rate-index: 0;
    in property <[string]> codec-options: ["H.264", "AV1"];
    in-out property <int> codec-index: 0;
    in-out property <bool> extra-quality: false;
    in-out property <int> tolerance-percent: 25;
    in-out property <string> estimated-size-text: "estimate unavailable";
    in-out property <bool> apply-to-all: true;
    in-out property <bool> use-hardware-encoding: false;
    // Set once from Rust at startup, from a one-time `ffmpeg -encoders`
    // probe — true when this machine's ffmpeg build reports the given
    // NVENC encoder as available.
    in property <bool> nvenc-h264-available: false;
    in property <bool> nvenc-av1-available: false;
    in-out property <string> hardware-status-text: "";

    callback settings-changed();
    callback apply-to-all-changed(bool);
}

export global ToolPipelineState {
    in-out property <[ToolItem]> items: [
        { kind: "compress", enabled: true, expanded: true },
        { kind: "transform", enabled: true, expanded: false },
        { kind: "crop", enabled: true, expanded: false },
        { kind: "resolution", enabled: true, expanded: false },
        { kind: "audio", enabled: true, expanded: false },
    ];
    callback toggle-requested(int, bool);
    callback move-requested(int, int);
    callback expand-toggle-requested(int, bool);
}

export global QueueState {
    in-out property <[QueueItem]> items;
    in-out property <int> count: 0;
    in-out property <int> active-index: -1;
    in-out property <string> current-name: "";
    in-out property <string> previous-name: "";
    in-out property <string> next-name: "";
    in-out property <string> position-text: "";
    in-out property <bool> can-previous: false;
    in-out property <bool> can-next: false;

    callback add-clicked();
    callback remove-clicked();
    callback select-clicked(int);
    callback previous-clicked();
    callback next-clicked();
}

export enum ExportPhase {
    idle,
    running,
    success,
    failed,
}

export global ExportDialogState {
    in-out property <bool> visible: false;
    in-out property <ExportPhase> phase: ExportPhase.idle;
    in-out property <string> destination-path: "";
    in-out property <float> progress: 0;
    in-out property <string> result-message: "";
    // Set by Rust before showing the dialog, based on which button the
    // user clicked (Export This Video vs Export All).
    in-out property <bool> export-current-only: false;

    callback browse-clicked();
    callback start-clicked();
    callback cancel-clicked();
    callback close-clicked();
}

export global AppearanceState {
    in-out property <bool> visible: false;
    // 0 = Appearance tab, 1 = Defaults (persistence) tab.
    in-out property <int> active-tab: 0;
    // 0 = Dark, 1 = Light, 2 = Match System.
    in-out property <int> theme-mode-index: 0;
    // Set once from Rust at startup — true only in a build compiled with
    // Slint's "qt" style (the `qt-style` Cargo feature).
    in property <bool> native-style-available: false;
    // Set once from Rust at startup — true when running on KDE but this
    // build doesn't have native-style-available.
    in property <bool> kde-detected: false;

    callback theme-mode-selected(int);
    callback open-requested();
    callback close-clicked();
}

export struct ToolPersistenceRow {
    kind: string,
    label: string,
    // 0 = persists across app restart, 1 = persists to new videos this
    // session only, 2 = never persists (always the built-in default).
    mode-index: int,
}

export global PersistenceSettingsState {
    in-out property <[ToolPersistenceRow]> rows: [];

    callback mode-selected(string, int);
}

export struct ShortcutRow {
    action: string,
    label: string,
    binding-text: string,
}

export global ShortcutsState {
    in-out property <[ShortcutRow]> rows: [];
    // Index into `rows` currently being (re)recorded, or -1 when nothing is
    // being recorded. Drives the capture overlay in app.slint.
    in-out property <int> listening-index: -1;

    callback row-clicked(int);
    // text, ctrl, shift, alt, meta — from the capture overlay's key-pressed.
    callback key-captured(string, bool, bool, bool, bool);
    // button-ordinal (0=left,1=right,2=middle,3=back,4=forward,5=other),
    // ctrl, shift, alt, meta — from the capture overlay's pointer-event.
    callback mouse-captured(int, bool, bool, bool, bool);
    // Escape while listening: closes the overlay, binding unchanged.
    callback listening-cancelled();
    callback reset-defaults-clicked();

    // Global dispatch: the app's root FocusScope / mouse-catcher forward
    // every key-press / click here; Rust returns whether a configured
    // shortcut matched and was handled.
    callback dispatch-key(string, bool, bool, bool, bool) -> bool;
    callback dispatch-mouse(int, bool, bool, bool, bool) -> bool;
}
