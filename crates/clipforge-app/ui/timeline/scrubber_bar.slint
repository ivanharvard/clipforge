import { Theme } from "../theme.slint";
import { PlaybackState } from "../state.slint";
import { IconButton } from "../components/icon_button.slint";
import { LineEdit } from "std-widgets.slint";

export component ScrubberBar inherits Rectangle {
    height: 96px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border-color;

    VerticalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;
        padding-top: Theme.space-2;
        padding-bottom: Theme.space-2;
        spacing: Theme.space-2;

        HorizontalLayout {
            height: 40px;
            spacing: Theme.space-3;
            cross-axis-alignment: center;

            IconButton {
                icon: PlaybackState.playing
                    ? @image-url("../../icons/ui/pause.svg")
                    : @image-url("../../icons/ui/play.svg");
                accessible-label: PlaybackState.playing ? "Pause" : "Play";
                clicked => { PlaybackState.play-pause-clicked(); }
            }

            Rectangle {
                width: 82px;
                height: 32px;
                Text {
                    text: PlaybackState.current-time-text;
                    color: Theme.text-secondary;
                    font-size: Theme.text-xs;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            track := Rectangle {
                property <int> drag-target: 0;
                property <length> hit-radius: 12px;

                background: Theme.surface-alt;
                border-radius: Theme.radius-control;
                horizontal-stretch: 1;
                height: 32px;
                clip: true;

                Rectangle {
                    x: PlaybackState.in-point-position * track.width;
                    width: (PlaybackState.out-point-position - PlaybackState.in-point-position) * track.width;
                    height: 100%;
                    background: Theme.accent.with-alpha(0.22);
                }
                Rectangle {
                    x: PlaybackState.playhead-position * track.width - 1px;
                    width: 2px;
                    height: 100%;
                    background: Theme.text-primary;
                }
                Rectangle {
                    x: PlaybackState.in-point-position * track.width - 4px;
                    width: 8px;
                    height: 100%;
                    background: Theme.accent;
                    border-radius: 3px;
                }
                Rectangle {
                    x: PlaybackState.out-point-position * track.width - 4px;
                    width: 8px;
                    height: 100%;
                    background: Theme.accent;
                    border-radius: 3px;
                }

                scrubber-touch := TouchArea {
                    mouse-cursor: track.drag-target == 1 || track.drag-target == 2 ? ew-resize : pointer;
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down) {
                            if (Math.abs(self.pressed-x / self.width - PlaybackState.in-point-position) * self.width < track.hit-radius) {
                                track.drag-target = 1;
                                PlaybackState.trim-drag-started();
                            } else if (Math.abs(self.pressed-x / self.width - PlaybackState.out-point-position) * self.width < track.hit-radius) {
                                track.drag-target = 2;
                                PlaybackState.trim-drag-started();
                            } else {
                                track.drag-target = 3;
                                PlaybackState.seek-requested(self.pressed-x / self.width);
                            }
                        } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                            track.drag-target = 0;
                        }
                    }
                    moved => {
                        if (track.drag-target == 1) {
                            PlaybackState.in-point-drag-requested(self.mouse-x / self.width);
                        } else if (track.drag-target == 2) {
                            PlaybackState.out-point-drag-requested(self.mouse-x / self.width);
                        } else if (track.drag-target == 3) {
                            PlaybackState.seek-requested(self.mouse-x / self.width);
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            alignment: center;
            cross-axis-alignment: center;
            spacing: Theme.space-2;
            Rectangle {}
            Text { text: "Start"; color: Theme.text-secondary; font-size: Theme.text-xs; vertical-alignment: center; }
            LineEdit {
                width: 104px;
                height: 28px;
                text: PlaybackState.in-point-time-text;
                accepted => { PlaybackState.in-point-text-submitted(self.text); }
            }
            Rectangle { width: Theme.space-6; }
            Text { text: "End"; color: Theme.text-secondary; font-size: Theme.text-xs; vertical-alignment: center; }
            LineEdit {
                width: 104px;
                height: 28px;
                text: PlaybackState.out-point-time-text;
                accepted => { PlaybackState.out-point-text-submitted(self.text); }
            }
            Rectangle {}
        }
    }
}
