import { Theme } from "../theme.slint";
import { PlaybackState } from "../state.slint";
import { IconButton } from "../components/icon_button.slint";
import { LineEdit } from "std-widgets.slint";

// Bottom bar: transport control beside a thick in/out trim track
// (DESIGN.md section 15). Positions are 0.0-1.0 fractions of the clip
// duration; Rust converts to/from milliseconds via `PlaybackState`.
export component ScrubberBar inherits Rectangle {
    height: 72px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border-color;

    HorizontalLayout {
        padding: Theme.space-3;
        spacing: Theme.space-3;

        IconButton {
            icon: PlaybackState.playing
                ? @image-url("../../icons/ui/pause.svg")
                : @image-url("../../icons/ui/play.svg");
            accessible-label: PlaybackState.playing ? "Pause" : "Play";
            clicked => { PlaybackState.play-pause-clicked(); }
        }

        Text {
            text: PlaybackState.current-time-text;
            color: Theme.text-secondary;
            font-size: Theme.text-xs;
            vertical-alignment: center;
        }


        VerticalLayout {
            spacing: 1px;
            horizontal-stretch: 0;

            Text {
                text: "In";
                color: Theme.text-secondary;
                font-size: Theme.text-xs;
            }

            LineEdit {
                width: 86px;
                height: 28px;
                text: PlaybackState.in-point-time-text;
                accepted => { PlaybackState.in-point-text-submitted(self.text); }
            }
        }

        track := Rectangle {
            // 0 = idle, 1/2 = trim handles, 3 = playhead.
            property <int> drag-target: 0;
            // How close (in px) a press must be to a handle to grab it
            // instead of seeking.
            property <length> hit-radius: 10px;

            background: Theme.surface-alt;
            border-radius: Theme.radius-control;
            horizontal-stretch: 1;
            height: 40px;
            clip: true;

            scrubber-touch := TouchArea {
                mouse-cursor: track.drag-target == 1 || track.drag-target == 2
                    || (self.has-hover && (Math.abs(self.mouse-x / self.width - PlaybackState.in-point-position) * self.width < track.hit-radius
                        || Math.abs(self.mouse-x / self.width - PlaybackState.out-point-position) * self.width < track.hit-radius))
                    ? ew-resize
                    : self.pressed ? grabbing : grab;
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        if (Math.abs(self.pressed-x / self.width - PlaybackState.in-point-position) * self.width < track.hit-radius) {
                            track.drag-target = 1;
                            PlaybackState.trim-drag-started();
                        } else if (Math.abs(self.pressed-x / self.width - PlaybackState.out-point-position) * self.width < track.hit-radius) {
                            track.drag-target = 2;
                            PlaybackState.trim-drag-started();
                        } else {
                            track.drag-target = 3;
                            PlaybackState.seek-requested(self.pressed-x / self.width);
                        }
                    } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                        track.drag-target = 0;
                    }
                }

                moved => {
                    if (track.drag-target == 1) {
                        PlaybackState.in-point-drag-requested(self.mouse-x / self.width);
                    } else if (track.drag-target == 2) {
                        PlaybackState.out-point-drag-requested(self.mouse-x / self.width);
                    } else if (track.drag-target == 3) {
                        PlaybackState.seek-requested(self.mouse-x / self.width);
                    }
                }
            }

            Rectangle {
                x: PlaybackState.in-point-position * track.width;
                width: (PlaybackState.out-point-position - PlaybackState.in-point-position) * track.width;
                height: 100%;
                background: Theme.accent.with-alpha(0.2);
            }

            Rectangle {
                x: PlaybackState.playhead-position * track.width - 1px;
                width: 2px;
                height: 100%;
                background: Theme.accent;
            }

            Rectangle {
                x: PlaybackState.in-point-position * track.width - 4px;
                width: 8px;
                height: 100%;
                background: Theme.accent;
                border-radius: 3px;
                opacity: scrubber-touch.has-hover
                    && Math.abs(scrubber-touch.mouse-x / scrubber-touch.width - PlaybackState.in-point-position) * scrubber-touch.width < track.hit-radius
                    ? 1 : 0.8;
                animate opacity { duration: 100ms; easing: ease-out; }
            }

            Rectangle {
                x: PlaybackState.out-point-position * track.width - 4px;
                width: 8px;
                height: 100%;
                background: Theme.accent;
                border-radius: 3px;
                opacity: scrubber-touch.has-hover
                    && Math.abs(scrubber-touch.mouse-x / scrubber-touch.width - PlaybackState.out-point-position) * scrubber-touch.width < track.hit-radius
                    ? 1 : 0.8;
                animate opacity { duration: 100ms; easing: ease-out; }
            }
        }

        VerticalLayout {
            spacing: 1px;
            horizontal-stretch: 0;

            Text {
                text: "Out";
                color: Theme.text-secondary;
                font-size: Theme.text-xs;
            }

            LineEdit {
                width: 86px;
                height: 28px;
                text: PlaybackState.out-point-time-text;
                accepted => { PlaybackState.out-point-text-submitted(self.text); }
            }
        }
    }
}
